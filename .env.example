# Copy this file to .env and fill in your own values. Never commit .env (it holds passwords).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=traffic_db

# Local MongoDB, or paste your MongoDB Atlas connection string instead
MONGO_URI=mongodb://localhost:27017
MONGO_DB=traffic_db
