# Copy this file to api/.env and put your own values in it.
# Never commit api/.env (it has your password).

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DB=traffic_db

MONGO_URI=mongodb://localhost:27017
MONGO_DB=traffic_db
MONGO_COLLECTION=traffic_records
